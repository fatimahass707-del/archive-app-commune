# انسخي هذا الملف وسميه .env ثم عبئي القيم الحقيقية ديالك
PORT=5000

DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=
DB_NAME=archive_jamaa

JWT_SECRET=change_this_to_a_long_random_secret_key
JWT_EXPIRES_IN=8h

# الحجم الأقصى لكل ملف بالميغابايت
MAX_FILE_SIZE_MB=15
# عناوين الـ Frontend المسموح بها (يمكن تضيفي عدة عناوين مفصولة بفاصلة)
# مثال للتطوير: http://localhost:5173,http://localhost:4173
# مثال للإنتاج: https://your-domain.com
FRONTEND_URL=http://localhost:5173,http://localhost:4173

